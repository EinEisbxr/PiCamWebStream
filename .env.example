# Public port to access the web interface
PORT=3000

# Backend configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8080
FRAME_RATE=30
FRAME_WIDTH=1920
FRAME_HEIGHT=1080
VIDEO_QUALITY=80

# Camera device (e.g. /dev/video0 for V4L2 or rpicam-vid for Raspberry Pi Camera)
# CAMERA_DEVICE=/dev/video0

# Optional: Stream Authentication
# STREAM_USER=admin
# STREAM_PASSWORD=password
